# -----------------------------------------------------------------------------
# Application BASE URL
# https://mksaas.com/docs/env#core-configuration
# For production, set to your domain, e.g. https://mksaas.com
# For development, set to http://localhost:3000 or any other port
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database
# https://mksaas.com/docs/database#setup
# -----------------------------------------------------------------------------
DATABASE_URL=""
# OneWorkOS governed analytics timeout (server clamps this to 1000-30000 ms).
ONEWORK_ANALYTICS_TIMEOUT_MS=10000
# Comma-separated payment price IDs that should grant OneWorkOS after payment.
# Leave empty to keep ordinary website membership payments separate.
ONEWORK_PRICE_IDS=""
ONEWORK_PACK_IDS="onework-workbuddy-v1"

# -----------------------------------------------------------------------------
# Better Auth
# https://mksaas.com/docs/auth#setup
# Generate a random string for the secret key using `openssl rand -base64 32`
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Github OAuth
# https://mksaas.com/docs/auth#2-configure-github-oauth
# https://www.better-auth.com/docs/authentication/github
# Get Client information from https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Google OAuth
# https://mksaas.com/docs/auth#3-configure-google-oauth
# https://www.better-auth.com/docs/authentication/google
# Get Client information from https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email / Newsletter (Resend)
# https://mksaas.com/docs/email#setup
# https://mksaas.com/docs/newsletter#setup
# Get API key and audience id from https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2 or S3-compatible service of your choice)
# https://mksaas.com/docs/storage#setup
# Cloudflare R2: https://www.cloudflare.com/developer-platform/products/r2
# -----------------------------------------------------------------------------
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# -----------------------------------------------------------------------------
# Knowledge image assets (Tencent COS; separate from the application's storage)
# Use a CAM sub-user restricted to knowledge/workbuddy/*.
# The endpoint must already include the bucket name (virtual-hosted style).
# -----------------------------------------------------------------------------
KNOWLEDGE_ASSET_REGION="ap-chengdu"
KNOWLEDGE_ASSET_BUCKET_NAME="onework-knowledge-1251991248"
KNOWLEDGE_ASSET_ACCESS_KEY_ID=""
KNOWLEDGE_ASSET_SECRET_ACCESS_KEY=""
KNOWLEDGE_ASSET_ENDPOINT="https://onework-knowledge-1251991248.cos.ap-chengdu.myqcloud.com"
KNOWLEDGE_ASSET_PUBLIC_URL="https://img.dlgzz.com"
KNOWLEDGE_ASSET_FORCE_PATH_STYLE="false"
# Optional comma-separated hosts allowed for inline video embed metadata.
# Normal Markdown clients should still render the canonical video URL as a link.
KNOWLEDGE_ASSET_EMBED_HOSTS=""

# -----------------------------------------------------------------------------
# Payment (Stripe)
# https://mksaas.com/docs/payment#setup
# Get Stripe key and secret from https://dashboard.stripe.com
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Pro plan - monthly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
# Pro plan - yearly subscription
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=""
# Lifetime plan - one-time payment
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=""

# -----------------------------------------------------------------------------
# Configurations
# -----------------------------------------------------------------------------
# Disable image optimization, check out next.config.ts for more details
DISABLE_IMAGE_OPTIMIZATION=false
# Run this website as demo website, in most cases, you should set this to false
NEXT_PUBLIC_DEMO_WEBSITE=false

# -----------------------------------------------------------------------------
# Hermes Bridge
# Server-side proxy used by /api/hermes/assistants.
# Run the bridge on the same Mac that can access Hermes CLI.
# -----------------------------------------------------------------------------
HERMES_BRIDGE_URL="http://127.0.0.1:7319"
HERMES_BRIDGE_TOKEN="change-me-to-a-long-random-secret"
HERMES_BRIDGE_TIMEOUT_MS=30000
HERMES_BRIDGE_HOST="127.0.0.1"
HERMES_BRIDGE_PORT=7319
HERMES_BRIDGE_WORKDIR="/Users/baiyang/Desktop/one-worker-os"
HERMES_BRIDGE_DRY_RUN=0
HERMES_BRIDGE_AUTO_START_GATEWAY=1
HERMES_BRIDGE_DATA_DIR="/Users/baiyang/Desktop/one-worker-os/.hermes-bridge"
HERMES_BRIDGE_COMMAND_TIMEOUT_MS=120000
HERMES_BRIDGE_ACTIVATION_TTL_MS=480000
HERMES_BRIDGE_QR_TIMEOUT_MS=10000
HERMES_ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# Learning Assistant Hermes backend
# Whiteboard APIs call this runner for create_student / create_bind_token /
# next_practice / record_quiz.
#
# Local development can keep using the Python skill directly.
# Production should set HERMES_LEARNING_ASSISTANT_URL to a cloud Hermes HTTP
# endpoint, so Zeabur does not try to spawn a local ~/.hermes script.
# -----------------------------------------------------------------------------
HERMES_LEARNING_ASSISTANT_URL=""
HERMES_LEARNING_ASSISTANT_TOKEN=""
HERMES_LEARNING_ASSISTANT_PYTHON="python3"
HERMES_LEARNING_ASSISTANT_SCRIPT="/Users/baiyang/.hermes/skills/learning-assistant/scripts/learning_assistant.py"
# Generate with: openssl rand -base64 48
LEARNING_ASSISTANT_STUDENT_ACCESS_SECRET=""
# Student whiteboard links expire after 24 hours by default (300-604800).
LEARNING_ASSISTANT_STUDENT_ACCESS_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Worker Companion Beta
# Keep public deployments closed by default. Use explicit beta allowlists for tests.
# Set WORKER_COMPANION_REQUIRE_MEMBERSHIP=0 only for private local smoke tests.
# Admin emails in HERMES_ADMIN_EMAILS are always allowed.
# -----------------------------------------------------------------------------
WORKER_DEFAULT_COMPANION_EMPLOYEE_ID="independent-companion"
WORKER_COMPANION_REQUIRE_MEMBERSHIP=1
WORKER_COMPANION_BETA_MODE=1
WORKER_COMPANION_BETA_EMAILS=""
WORKER_COMPANION_BETA_USER_IDS=""
AUTH_REQUIRE_EMAIL_VERIFICATION=1

# -----------------------------------------------------------------------------
# Analytics
# https://mksaas.com/docs/analytics#setup
# -----------------------------------------------------------------------------
# Google Analytics (https://analytics.google.com)
# https://mksaas.com/docs/analytics#google
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# -----------------------------------------------------------------------------
# Umami Analytics (https://umami.is)
# https://mksaas.com/docs/analytics#umami
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
# -----------------------------------------------------------------------------
# OpenPanel Analytics (https://openpanel.dev)
# https://mksaas.com/docs/analytics#openpanel
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=""
# -----------------------------------------------------------------------------
# Plausible Analytics (https://plausible.io)
# https://mksaas.com/docs/analytics#plausible
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
# -----------------------------------------------------------------------------
# Ahrefs Analytics (https://ahrefs.com)
# https://mksaas.com/docs/analytics#ahrefs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AHREFS_WEBSITE_ID=""
# -----------------------------------------------------------------------------
# Seline Analytics
# https://mksaas.com/docs/analytics#seline
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SELINE_TOKEN=""
# -----------------------------------------------------------------------------
# DataFast Analytics (https://datafa.st)
# https://mksaas.com/docs/analytics#datafast
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATAFAST_ANALYTICS_ID=""
NEXT_PUBLIC_DATAFAST_ANALYTICS_DOMAIN=""


# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""
NEXT_PUBLIC_DISCORD_WIDGET_SERVER_ID=""
NEXT_PUBLIC_DISCORD_WIDGET_CHANNEL_ID=""

# -----------------------------------------------------------------------------
# Feishu
# -----------------------------------------------------------------------------
FEISHU_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# Affiliate
# https://mksaas.com/docs/affiliate
# -----------------------------------------------------------------------------
# Affonso
# https://affonso.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_AFFONSO_ID=""
# -----------------------------------------------------------------------------
# PromoteKit
# https://www.promotekit.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_PROMOTEKIT_ID=""

# -----------------------------------------------------------------------------
# ALIYUN BAILIAN
# https://bailian.console.aliyun.com/
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=""

# -----------------------------------------------------------------------------
# Tldraw License (Required in production for whiteboard)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=""

# -----------------------------------------------------------------------------
# Whiteboard AI (Server-side only, do not expose via NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
WHITEBOARD_AI_PROVIDER=""
WHITEBOARD_COURSEWARE_PROVIDER="gemini"
WHITEBOARD_COURSEWARE_MODEL="gemini-3.5-flash"
GOOGLE_GEMINI_BASE_URL="https://api.apiyi.com/v1"
GEMINI_API_FORMAT="openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_CHAT_COMPLETIONS_URL="https://api.apiyi.com/v1/chat/completions"
GEMINI_ENABLE_NATIVE_FALLBACK="false"
GEMINI_AUTH_MODE="bearer"
ZHIPU_API_KEY=""
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_MODEL="glm-4"
